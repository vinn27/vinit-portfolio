---
import { profile } from "../data/portfolio";
const year = new Date().getFullYear();
---

<footer class="relative border-t border-hairline">
  <div class="mx-auto max-w-6xl px-5 py-8 sm:px-8">
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <div class="flex items-center gap-2.5">
        <span class="grid h-8 w-8 place-items-center rounded-lg border border-hairline bg-surface font-display text-xs font-bold text-brand">
          VS
        </span>
        <span class="font-mono text-xs text-faint">
          © {year} {profile.fullName}
        </span>
      </div>

      <div class="flex items-center gap-5 font-mono text-xs text-faint">
        <span>Built with Astro · GSAP · Tailwind</span>
        <a href="#top" class="transition-colors hover:text-brand">Back to top ↑</a>
      </div>
    </div>
  </div>
</footer>
