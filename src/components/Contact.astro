---
import { profile } from "../data/portfolio";
---

<section id="contact" class="section relative overflow-hidden">
  <!-- backdrop -->
  <div class="bg-grid pointer-events-none absolute inset-0 opacity-50 [mask-image:radial-gradient(60%_60%_at_50%_50%,#000,transparent)]"></div>
  <div class="pointer-events-none absolute left-1/2 top-1/3 h-72 w-72 -translate-x-1/2 rounded-full bg-brand/10 blur-[120px]"></div>

  <div class="relative mx-auto max-w-4xl px-5 text-center sm:px-8">
    <div data-reveal class="flex items-center justify-center gap-3">
      <span class="h-px w-8 bg-hairline"></span>
      <span class="eyebrow">06 / Contact</span>
      <span class="h-px w-8 bg-hairline"></span>
    </div>

    <h2 data-reveal data-delay="0.05" class="mx-auto mt-6 max-w-2xl text-balance font-display text-[clamp(2rem,6vw,3.6rem)] font-bold leading-[1.05] tracking-tight">
      Let's build something with
      <span class="gradient-text">clean data.</span>
    </h2>

    <p data-reveal data-delay="0.1" class="mx-auto mt-5 max-w-xl text-balance leading-relaxed text-muted">
      Open to Data Engineering opportunities, freelance pipelines and collaboration.
      Drop a line and I'll get back to you.
    </p>

    <div data-reveal data-delay="0.15" class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a href={`mailto:${profile.email}`} data-magnetic class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
        {profile.email}
      </a>
      <a href={`tel:${profile.phoneHref}`} data-magnetic class="btn btn-ghost">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        {profile.phone}
      </a>
    </div>

    <div data-reveal data-delay="0.2" class="mt-8 flex items-center justify-center gap-3">
      <a
        href={profile.socials.github}
        target="_blank"
        rel="noopener"
        data-magnetic
        aria-label="GitHub"
        class="grid h-11 w-11 place-items-center rounded-full border border-hairline bg-surface text-muted transition-colors hover:border-brand hover:text-brand"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a12 12 0 0 0-3.79 23.4c.6.1.82-.26.82-.58v-2.2c-3.34.73-4.04-1.4-4.04-1.4-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.3 3.5.99.1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.39 1.24-3.23-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.92 1.24 3.23 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .5z"/></svg>
      </a>
      <a
        href={profile.socials.linkedin}
        target="_blank"
        rel="noopener"
        data-magnetic
        aria-label="LinkedIn"
        class="grid h-11 w-11 place-items-center rounded-full border border-hairline bg-surface text-muted transition-colors hover:border-brand hover:text-brand"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
      </a>
    </div>
  </div>
</section>
