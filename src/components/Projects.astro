---
import SectionHeading from "./SectionHeading.astro";
import { projects } from "../data/portfolio";

const flow = ["Wikipedia API", "Redpanda", "PySpark", "Neon Postgres", "Live Dashboard"];
const featured = projects.find((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
---

<section id="projects" class="section relative">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeading
      index="04"
      eyebrow="Projects"
      title="Real data, modeled & shipped."
      description="End-to-end pipelines I've built — from raw ingest through streaming and star-schema modeling to BI-ready warehouses."
    />

    <div data-stagger class="mt-12 grid gap-5 md:grid-cols-2">
      {/* ---------------------------------------------------- Featured card */}
      {
        featured && (
          <article
            data-stagger-item
            data-tilt
            class="card-featured group relative overflow-hidden p-6 sm:p-9 md:col-span-2"
          >
            {/* accent glow */}
            <div class={`pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-gradient-to-br ${featured.accent} opacity-20 blur-[100px] transition-opacity duration-500 group-hover:opacity-35`} />

            <div class="relative">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <div class="flex flex-wrap items-center gap-3">
                    <div class="font-mono text-xs text-faint">{featured.tagline}</div>
                    <a
                      href={featured.liveUrl}
                      target="_blank"
                      rel="noopener"
                      class="live-badge"
                      aria-label={`Open ${featured.name} live dashboard`}
                    >
                      <span class="relative flex h-2 w-2">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-70" />
                        <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400" />
                      </span>
                      LIVE
                    </a>
                  </div>
                  <h3 class="mt-2 font-display text-2xl font-bold text-ink sm:text-3xl">
                    {featured.name}
                  </h3>
                </div>
                <span class={`mt-1 grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-gradient-to-br ${featured.accent} text-[#04141a] transition-transform duration-500 group-hover:rotate-45`}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
                </span>
              </div>

              <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted sm:text-base">
                {featured.description}
              </p>

              {/* animated data-flow diagram */}
              <div class="mt-6 flex flex-wrap items-center gap-y-2 rounded-xl border border-hairline bg-surface-2/60 px-4 py-3">
                <span class="mr-3 font-mono text-[10px] uppercase tracking-[0.2em] text-faint">flow</span>
                {flow.map((step, i) => (
                  <span class="flex items-center">
                    <span class={`rounded-md border px-2.5 py-1 font-mono text-[11px] ${i === flow.length - 1 ? "border-emerald-400/40 bg-emerald-400/10 text-emerald-300" : "border-hairline bg-surface text-muted"}`}>
                      {step}
                    </span>
                    {i < flow.length - 1 && <span class="flow-dash mx-2.5 inline-block h-px w-6 sm:w-8" aria-hidden="true" />}
                  </span>
                ))}
              </div>

              {/* metrics */}
              <div class="mt-6 flex flex-wrap gap-2.5">
                {featured.metrics.map((m) => (
                  <div class="rounded-lg border border-hairline bg-surface-2 px-3 py-1.5">
                    <div class="font-display text-sm font-bold text-ink">{m.value}</div>
                    <div class="font-mono text-[10px] uppercase tracking-wide text-faint">{m.label}</div>
                  </div>
                ))}
              </div>

              {/* stack */}
              <div class="mt-6 flex flex-wrap gap-2 border-t border-hairline pt-6">
                {featured.stack.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>

              {/* CTAs */}
              <div class="mt-6 flex flex-wrap gap-3">
                <a href={featured.liveUrl} target="_blank" rel="noopener" data-magnetic class="btn btn-primary">
                  View Live Dashboard
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
                </a>
                <a href={featured.link} target="_blank" rel="noopener" data-magnetic class="btn btn-ghost">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a12 12 0 0 0-3.79 23.4c.6.1.82-.26.82-.58v-2.2c-3.34.73-4.04-1.4-4.04-1.4-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.3 3.5.99.1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.39 1.24-3.23-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.92 1.24 3.23 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .5z"/></svg>
                  Source Code
                </a>
              </div>
            </div>
          </article>
        )
      }

      {/* ------------------------------------------------------- Other cards */}
      {
        rest.map((p) => (
          <article
            data-stagger-item
            data-tilt
            class="card card-hover group relative overflow-hidden p-6 sm:p-7"
          >
            {/* accent glow */}
            <div class={`pointer-events-none absolute -right-16 -top-16 h-40 w-40 rounded-full bg-gradient-to-br ${p.accent} opacity-20 blur-3xl transition-opacity duration-500 group-hover:opacity-40`} />

            <div class="relative">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <div class="font-mono text-xs text-faint">{p.tagline}</div>
                  <h3 class="mt-1.5 font-display text-lg font-semibold text-ink sm:text-xl">
                    {p.name}
                  </h3>
                </div>
                <a
                  href={p.link || p.liveUrl}
                  target={p.link || p.liveUrl ? "_blank" : undefined}
                  rel="noopener"
                  aria-label={p.link ? `Open ${p.name} on GitHub` : undefined}
                  class={`mt-1 grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-gradient-to-br ${p.accent} text-[#04141a] transition-transform duration-500 group-hover:rotate-45 ${p.link || p.liveUrl ? "" : "pointer-events-none"}`}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
                </a>
              </div>

              <p class="mt-4 text-sm leading-relaxed text-muted">{p.description}</p>

              {/* metrics */}
              <div class="mt-5 flex flex-wrap gap-2.5">
                {p.metrics.map((m) => (
                  <div class="rounded-lg border border-hairline bg-surface-2 px-3 py-1.5">
                    <div class="font-display text-sm font-bold text-ink">{m.value}</div>
                    <div class="font-mono text-[10px] uppercase tracking-wide text-faint">{m.label}</div>
                  </div>
                ))}
              </div>

              {/* stack */}
              <div class="mt-5 flex flex-wrap gap-2 border-t border-hairline pt-5">
                {p.stack.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
