---
import SectionHeading from "./SectionHeading.astro";
import { education } from "../data/portfolio";
---

<section id="education" class="section relative">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeading index="05" eyebrow="Education" title="Foundations." />

    <div data-reveal class="mt-12 max-w-3xl">
      <div class="card card-hover relative overflow-hidden p-7 sm:p-8">
        <div class="pointer-events-none absolute -left-20 -bottom-20 h-48 w-48 rounded-full bg-gradient-to-tr from-brand to-accent opacity-10 blur-3xl"></div>

        <div class="relative flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-start gap-4">
            <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl border border-hairline bg-surface-2 text-brand">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1 2.5 3 6 3s6-2 6-3v-5"/></svg>
            </div>
            <div>
              <h3 class="font-display text-lg font-semibold text-ink sm:text-xl">{education.degree}</h3>
              <p class="mt-1 text-muted">{education.school}</p>
              <p class="mt-3 text-sm leading-relaxed text-faint">{education.detail}</p>
            </div>
          </div>

          <div class="shrink-0 sm:text-right">
            <div class="font-mono text-xs text-faint">{education.period}</div>
            <div class="mt-1 text-sm text-muted">{education.location}</div>
            <div class="mt-3 inline-flex items-center gap-2 rounded-full border border-hairline bg-surface-2 px-3 py-1.5">
              <span class="font-mono text-xs text-faint">CGPA</span>
              <span class="font-display text-sm font-bold text-brand">7.96</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
