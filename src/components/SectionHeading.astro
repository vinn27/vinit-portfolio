---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}
const { index, eyebrow, title, description, align = "left" } = Astro.props;
---

<div class={align === "center" ? "mx-auto max-w-2xl text-center" : "max-w-2xl"}>
  <div data-reveal class={`flex items-center gap-3 ${align === "center" ? "justify-center" : ""}`}>
    <span class="font-mono text-xs text-faint">{index}</span>
    <span class="h-px w-8 bg-hairline"></span>
    <span class="eyebrow">{eyebrow}</span>
  </div>
  <h2
    data-reveal
    data-delay="0.05"
    class="mt-4 font-display text-[clamp(1.9rem,5vw,3rem)] font-bold leading-tight tracking-tight"
  >
    {title}
  </h2>
  {
    description && (
      <p data-reveal data-delay="0.1" class="mt-4 text-balance leading-relaxed text-muted">
        {description}
      </p>
    )
  }
</div>
